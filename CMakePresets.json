{
  "version": 3,
  "configurePresets": [
    {
      "name": "vscode-debug",
      "displayName": "VSCode Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/vscode-vs-debug",
      "cacheVariables": {
        "AUTOCHESS_BUILD_GUI": "ON",
        "AUTOCHESS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "vscode-core-debug",
      "displayName": "VSCode Core Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/vscode-vs-core-debug",
      "cacheVariables": {
        "AUTOCHESS_BUILD_GUI": "OFF",
        "AUTOCHESS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "training-x64-debug",
      "displayName": "Training x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/training-x64-debug",
      "cacheVariables": {
        "AUTOCHESS_BUILD_GUI": "OFF",
        "AUTOCHESS_BUILD_TESTS": "ON",
        "AUTOCHESS_BUILD_PYTHON": "ON"
      }
    },
    {
      "name": "training-linux-release",
      "displayName": "Training Linux Release",
      "binaryDir": "${sourceDir}/build/training-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AUTOCHESS_BUILD_GUI": "OFF",
        "AUTOCHESS_BUILD_TESTS": "ON",
        "AUTOCHESS_BUILD_PYTHON": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-debug",
      "configurePreset": "vscode-debug",
      "configuration": "Debug"
    },
    {
      "name": "vscode-core-debug",
      "configurePreset": "vscode-core-debug",
      "configuration": "Debug"
    },
    {
      "name": "training-x64-debug",
      "configurePreset": "training-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "training-linux-release",
      "configurePreset": "training-linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "vscode-debug",
      "configurePreset": "vscode-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "vscode-core-debug",
      "configurePreset": "vscode-core-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "training-x64-debug",
      "configurePreset": "training-x64-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "training-linux-release",
      "configurePreset": "training-linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
